#!/usr/bin/env python3
"""Run stack-base against this project's infra/ directory.

This little script is the whole entry point: `./infra/up --plan`, `./infra/up`.
It works out which version of stack-base this project is pinned to, downloads
that exact version into ~/.cache/stack-base/<rev> (once), and hands over to it.

It depends on nothing but Python 3, git and ssh -- you do not need Nix, and
you do not need stack-base checked out anywhere.

To work on stack-base itself, point $STACKBASE_SRC at a local checkout
instead and this script runs that directly:

    STACKBASE_SRC=~/code/stack-base ./infra/up --plan
"""

from __future__ import annotations

import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

INFRA_DIR = Path(__file__).resolve().parent
CACHE_DIR = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "stack-base"


def fail(message: str, hint: str) -> None:
    print(f"error: {message} — {hint}", file=sys.stderr)
    raise SystemExit(1)


def run(argv: list[str]) -> None:
    result = subprocess.run(argv, capture_output=True, text=True, check=False)
    if result.returncode != 0:
        detail = (result.stderr or result.stdout or "").strip().splitlines()
        fail(
            f"{argv[0]} failed while downloading stack-base",
            detail[-1] if detail else "check your network connection and try again",
        )


def locked_stack_base(lock_path: Path) -> tuple[str, str]:
    """The git URL and commit this project pins stack-base to."""
    try:
        lock = json.loads(lock_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        fail(f"{lock_path} could not be read", str(exc))

    nodes = lock.get("nodes", {})
    root = nodes.get(lock.get("root", "root"), {})
    ref = root.get("inputs", {}).get("stack-base")
    if isinstance(ref, list):
        ref = ref[0] if ref else None
    node = nodes.get(ref) if isinstance(ref, str) else None
    if not isinstance(node, dict):
        node = nodes.get("stack-base")
    locked = node.get("locked") if isinstance(node, dict) else None
    if not isinstance(locked, dict) or not isinstance(locked.get("rev"), str):
        fail(
            f"{lock_path} does not pin a 'stack-base' input",
            "set $STACKBASE_SRC to a local stack-base checkout, or ask whoever set this project "
            "up to commit a working infra/flake.lock",
        )

    rev = locked["rev"]
    if locked.get("type") == "github":
        return f"https://github.com/{locked['owner']}/{locked['repo']}.git", rev
    if isinstance(locked.get("url"), str):
        return locked["url"], rev
    fail(
        f"{lock_path} pins stack-base from an unsupported source",
        "stack-base must be pinned from GitHub or a plain git URL",
    )
    raise AssertionError("unreachable")  # pragma: no cover


# Matches `inputs.stack-base.url = "github:OWNER/REPO";` or
# `"github:OWNER/REPO/REF";` in flake.nix. REPO is matched non-greedily so
# the optional `/REF` group (which may itself contain slashes, e.g. a
# branch like `refs/heads/foo`) gets first refusal on everything after the
# first slash.
# owner and repo are GitHub names; ref is a tag or branch. Every group is
# limited to name characters and may not start with `-`, so nothing parsed
# out of flake.nix can ever reach git as a flag (`--upload-pack=...`).
_STACKBASE_INPUT_RE = re.compile(
    r'inputs\.stack-base\.url\s*=\s*"github:'
    r'([A-Za-z0-9_][A-Za-z0-9._-]*)/([A-Za-z0-9_][A-Za-z0-9._-]*?)'
    r'(?:/([A-Za-z0-9_][A-Za-z0-9._/-]*))?"'
)


def _resolve_ref_to_rev(url: str, ref: str) -> str | None:
    """The commit `ref` (a tag, branch, or "HEAD") currently points to.

    Returns None on any failure -- a missing network, a typo'd ref, a repo
    that does not exist -- so the caller can fall back to the existing
    "commit a flake.lock" error rather than surfacing a confusing git error.
    """
    result = subprocess.run(
        # The `^{}` pattern is not decoration: ls-remote only prints the
        # peeled line (the COMMIT an annotated tag points at) when a pattern
        # matches it. Without it the resolved sha is the tag object itself,
        # which is not a commit and fails the pinned-checkout check later.
        ["git", "ls-remote", "--", url, ref, f"refs/tags/{ref}", f"refs/tags/{ref}^{{}}", f"refs/heads/{ref}"],
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        return None
    lines = [line for line in result.stdout.splitlines() if line.strip()]
    if not lines:
        return None
    # An annotated tag's own object and the commit it points at are two
    # different shas; git ls-remote lists both, with the peeled commit on a
    # line ending "^{}". We want the commit, so prefer that line when
    # present -- otherwise the first line (a lightweight tag, a branch, or
    # HEAD) is already the commit.
    peeled_name = f"refs/tags/{ref}^{{}}"
    for line in lines:
        sha, _, name = line.partition("\t")
        if name == peeled_name:
            return sha or None
    sha, _, _ = lines[0].partition("\t")
    return sha or None


def unlocked_stack_base(flake_path: Path) -> tuple[str, str] | None:
    """Resolve stack-base straight from flake.nix, before a flake.lock exists.

    A freshly scaffolded project has no flake.lock yet -- normally stack-base
    itself writes one, on the first successful run, but that first run needs
    something to fetch. So: parse the `stack-base` input out of flake.nix and
    resolve its ref to a commit with `git ls-remote`, using the exact same
    download/cache/verify path a locked project uses.

    Returns None (never raises) for anything that isn't a clean resolution --
    no flake.nix, no matching input, or a failed/empty `git ls-remote` --
    so the caller falls back to the existing "commit a flake.lock, or set
    STACKBASE_SRC" error instead of a confusing git failure.
    """
    try:
        text = flake_path.read_text(encoding="utf-8")
    except OSError:
        return None

    match = _STACKBASE_INPUT_RE.search(text)
    if not match:
        return None
    owner, repo, ref = match.group(1), match.group(2), match.group(3) or "HEAD"

    url = f"https://github.com/{owner}/{repo}.git"
    rev = _resolve_ref_to_rev(url, ref)
    if rev is None:
        return None

    print(
        f"no infra/flake.lock yet — resolving {ref} from github:{owner}/{repo} "
        "(the first run writes the lock)",
        file=sys.stderr,
    )
    return url, rev


def cache_root() -> Path:
    """The cache directory, created private and refused if it is not.

    Whatever ends up in here gets executed, so a directory some other account
    can write to is a way for them to run code as you.
    """
    CACHE_DIR.parent.mkdir(parents=True, exist_ok=True)
    if not CACHE_DIR.exists():
        CACHE_DIR.mkdir(mode=0o700)
        os.chmod(CACHE_DIR, 0o700)  # mkdir's mode is filtered through the umask

    info = CACHE_DIR.stat()
    if info.st_uid != os.getuid():
        fail(
            f"{CACHE_DIR} belongs to another user",
            "stack-base runs code from that directory, so it has to be yours -- move it aside",
        )
    if info.st_mode & 0o077:
        fail(
            f"{CACHE_DIR} can be read or written by other users",
            f"stack-base runs code from that directory -- run: chmod 700 {CACHE_DIR}",
        )
    return CACHE_DIR


def git_output(repo: Path, *args: str) -> str | None:
    result = subprocess.run(
        ["git", "-C", str(repo), *args], capture_output=True, text=True, check=False
    )
    return result.stdout if result.returncode == 0 else None


def is_pinned_checkout(checkout: Path, rev: str) -> bool:
    """True only if `checkout` is exactly commit `rev`, with nothing altered."""
    if not (checkout / ".git").is_dir():
        return False
    head = git_output(checkout, "rev-parse", "HEAD")
    if head is None or head.strip() != rev:
        return False
    # --porcelain lists modified tracked files AND untracked ones while
    # honouring .gitignore, so caches and build output do not count as
    # tampering but an edited or planted file does.
    dirty = git_output(checkout, "status", "--porcelain")
    return dirty is not None and dirty.strip() == ""


def fetch(url: str, rev: str) -> Path:
    """Return a checkout of exactly `rev`, downloading it if need be.

    This check runs on every run, cache hit or miss: a directory sitting at
    `<cache>/<rev>` with a `bin/up` in it is not evidence that it came from
    the pinned repository -- anything able to write there could have put it
    there. Only `git rev-parse HEAD` reporting `rev`, over a clean working
    tree, is evidence. Anything else is discarded and fetched again once; if
    the fresh copy still does not match, nothing is executed at all.
    """
    checkout = cache_root() / rev
    if is_pinned_checkout(checkout, rev):
        return checkout

    if checkout.exists():
        print(
            f"warning: the cached copy of stack-base at {checkout} is not commit {rev[:12]} "
            "(or has been modified) -- discarding it and downloading it again",
            file=sys.stderr,
        )
        shutil.rmtree(checkout, ignore_errors=True)

    download(url, rev, checkout)

    if not is_pinned_checkout(checkout, rev):
        fail(
            f"the downloaded copy of stack-base is not commit {rev[:12]}",
            f"remove {checkout} and try again -- if it keeps happening, the pinned commit may no "
            "longer exist in the repository infra/flake.lock points at",
        )
    return checkout


def download(url: str, rev: str, checkout: Path) -> None:
    # A plain `git clone` cannot ask for one arbitrary commit, so: an empty
    # repository, one shallow fetch of that exact rev, one checkout. It lands
    # in a temporary directory and is renamed into place, so an interrupted
    # download never leaves a half-finished cache entry behind.
    staging = checkout.parent / f".{rev}.partial.{os.getpid()}"
    shutil.rmtree(staging, ignore_errors=True)
    staging.mkdir(parents=True)
    try:
        run(["git", "init", "--quiet", str(staging)])
        run(["git", "-C", str(staging), "fetch", "--depth", "1", url, rev])
        run(["git", "-C", str(staging), "checkout", "--quiet", "FETCH_HEAD"])
        os.replace(staging, checkout)
    finally:
        shutil.rmtree(staging, ignore_errors=True)


def entry_point() -> Path:
    source = os.environ.get("STACKBASE_SRC")
    if source:
        entry = Path(source).expanduser().resolve() / "bin" / "up"
        if not entry.exists():
            fail(
                f"$STACKBASE_SRC does not look like a stack-base checkout ({entry} is missing)",
                "point $STACKBASE_SRC at the root of a stack-base clone",
            )
        return entry

    lock_path = INFRA_DIR / "flake.lock"
    if not lock_path.exists():
        resolved = unlocked_stack_base(INFRA_DIR / "flake.nix")
        if resolved is not None:
            url, rev = resolved
            # Tell the tool which commit is in play: with no lock to read,
            # it needs this to fingerprint the run (and refuses without it).
            os.environ["STACKBASE_RESOLVED_REV"] = rev
            return fetch(url, rev) / "bin" / "up"
        fail(
            f"{lock_path} is missing, so this project does not pin a version of stack-base",
            "either commit an infra/flake.lock (stack-base writes one for you after the first "
            "successful run), or set $STACKBASE_SRC to a local stack-base checkout",
        )
    url, rev = locked_stack_base(lock_path)
    return fetch(url, rev) / "bin" / "up"


def _with_implicit_up(args: list[str]) -> list[str]:
    """Insert the `up` subcommand when the caller left it out.

    stack-base's subparsers are `required=True`, so the documented shortcuts
    -- `./infra/up`, `./infra/up --plan`, `./infra/up --allow-purchase` --
    would otherwise exit 2 with an argparse usage error; only a command that
    already names a real subcommand (`./infra/up ssh a`, `./infra/up up
    --plan`) or asks for top-level help (`-h`/`--help`) works. Anything else
    with no args, or whose first token looks like an option, gets `up`
    inserted ahead of it.
    """
    if not args:
        return ["up"]
    if args[0] in ("-h", "--help"):
        return args
    if args[0].startswith("-"):
        return ["up", *args]
    return args


def main() -> None:
    entry = entry_point()
    # --infra-dir goes first: it is a global option, and argparse wants
    # globals before the subcommand.
    argv = [
        sys.executable,
        str(entry),
        "--infra-dir",
        str(INFRA_DIR),
        *_with_implicit_up(sys.argv[1:]),
    ]
    os.execv(sys.executable, argv)


if __name__ == "__main__":
    main()
