# This file describes the servers this project should have. Edit it, run
# `./infra/up --plan` to see what would change, then `./infra/up` to do it.
# Copy it to stack.toml and fill it in.

# Short name for this project. Lowercase letters, digits and dashes.
# It names the database, the app's socket directory and the firewall.
project = "acme"

# The public web address this project serves. Its Cloudflare zone is found
# automatically (acme.example.com is served by the example.com zone).
domain = "acme.example.com"

# Whoever owns this project -- a GitHub handle. Informational.
owner = "your-github-handle"

# Which Hostinger data centre the servers live in. Run
# `./infra/up --plan` with a wrong value and the error lists the valid ones.
datacenter = "kul"

# The VPS plan, exactly as Hostinger names it. This is what you type back
# when confirming a purchase ("buy KVM 1 x1"), so keep it accurate.
plan = "KVM 1"

# Only needed to BUY a server. It is Hostinger's catalog price-item id for
# the plan above (something like "hostingercom-vps-kvm1-usd-1m"). Leave it
# empty if you already own every server listed below -- stack-base cannot
# buy anything without it.
price_item = ""

# Install security updates automatically. Leave this on.
auto_patch = true

# Everyone who gets an account and SSH access on every server. Each name
# needs a matching infra/keys/<name>.pub file, committed to this repository.
# Removing a name here removes that person's access on the next run.
admins = ["your-name"]

# One section per server. The name ("a") is what you type in
# `./infra/up ssh a`, and it becomes the machine's hostname.
[nodes.a]
# Exactly one node must be "primary": that is the one the domain points at.
# Any others are "replica".
role = "primary"

# The Hostinger id of a server you already own. You can read it off the URL
# in hPanel. Leave this line (and this comment) out entirely if you want
# stack-base to buy the server for you -- it will then ask you to confirm,
# in writing, first.
# vps_id = 1234567

# A second server would look like this:
#
# [nodes.b]
# role = "replica"

# The app's own environment (DATABASE_URL, session/CSRF secrets, OAuth
# credentials, ...) is NOT set here -- it lives in secrets.age as the
# "app_env" key. See the README's "The app's environment (app_env)" section.

# Optional. The release engine expects the built binary's name to match
# this project's slug with "-" -> "_" (so "acme" expects "acme"); if your
# crate's [package].name or [[bin]] name is different, set it here --
# `./infra/up deploy` refuses to build otherwise, with the exact value to
# paste. health_path/health_tries/health_sleep override the release
# engine's health check (default "/health", 30 tries, 2s apart);
# `./infra/up smoke` also fetches https://<domain><health_path>, unless
# smoke_public = false (a project with no public front door).
# [app]
# binary = "my_crate_name"
# health_path = "/health"
# health_tries = 30
# health_sleep = 2
# smoke_public = true

# REQUIRED (since v0.2.0; uncomment one choice): nightly off-box backups.
# The project's database, plus any directories listed here, encrypted to
# infra/age-recipients.txt and uploaded to Cloudflare R2. Name a bucket to
# turn them on (the credentials live in secrets.age as r2_access_key_id,
# r2_secret_access_key and r2_endpoint), or write `enabled = false` to opt
# out -- `up` then warns on every run. With neither, `up` refuses.
# retention_days defaults to 30 and on_calendar to "03:00" (UTC).
# [backups]
# bucket = "acme-backups"
# enabled = false
# retention_days = 30
# extra_paths = ["/var/lib/acme/uploads"]
# on_calendar = "03:00"

# REQUIRED (since v0.2.0; uncomment one choice): the servers' journal,
# shipped off-box to R2 by Vector. Name a bucket (its own R2 token:
# logs_access_key_id and logs_secret_access_key in the secrets) or opt out
# with `enabled = false`. Needs the cloudflare_account_id secret, to set the
# retention rule. retention_days defaults to 90.
# [logs]
# bucket = "acme-logs"
# enabled = false
# retention_days = 90

# Optional. Who is mailed when any service on the servers fails. Needs the
# smtp_host, smtp_port, smtp_user, smtp_password and smtp_from secrets.
# Without it `up` warns but carries on. See the README's "Alerts" section.
# [alerts]
# to = ["ops@example.com"]

# Optional. Join the servers to Cloudflare Mesh (headless cloudflare-warp,
# firewall not opened). Each environment needs the mesh_connector_token
# secret. See the README's "Mesh" section.
# [mesh]
# enabled = true

# Optional. Uploaded files in R2, under a bucket lock: objects can be neither
# deleted nor overwritten for lock_days (1-3650, default 30). The app gets
# STORAGE_* variables; set files_access_key_id and files_secret_access_key
# in the environment's secrets. See the README's "Uploaded files in R2".
# [files]
# bucket = "acme-files"
# lock_days = 30

# Optional. Staging and production from this one file. Replace the
# top-level `domain` and [nodes.*] above with one table per environment;
# everything else in this file is then shared, so the two match. An
# environment may set only its domain, its nodes, plan/price_item, and the
# bucket/retention_days/to/lock_days keys of [backups], [logs], [alerts]
# and [files], plus `enabled = false` in [backups] / [logs] to opt that
# environment out. Every command then needs --env (`./infra/up --env staging
# up --plan`), and each environment keeps its own stack.state.<env>.json,
# secrets.<env>.age and deploy.<env>.age. See the README's "Staging and
# production" section.
#
# [environments.staging]
# domain = "staging.acme.example.com"
# backups.bucket = "acme-backups-staging"
#
# [environments.staging.nodes.a]
# role = "primary"
#
# [environments.production]
# domain = "acme.example.com"
#
# [environments.production.nodes.a]
# role = "primary"
