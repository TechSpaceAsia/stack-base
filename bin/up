#!/usr/bin/env python3
"""Entrypoint: resolves the repo root (even via a symlink) and runs stackbase."""

import sys
from pathlib import Path


def main() -> None:
    repo_root = Path(__file__).resolve().parent.parent
    sys.path.insert(0, str(repo_root))

    try:
        from stackbase.__main__ import main as stackbase_main
    except ImportError as e:
        print(f"stack-base is not fully installed yet: {e}", file=sys.stderr)
        sys.exit(1)

    stackbase_main()


if __name__ == "__main__":
    main()
